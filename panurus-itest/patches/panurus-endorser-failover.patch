+// hasValidationRecord reports whether txID already has a validation record for exactly tokenRequest.
+// ponytail: scans all records; only runs after a failed insert (a retried endorsement), add a txid query if it gets hot.
+func (d *StoreService) hasValidationRecord(ctx context.Context, txID string, tokenRequest []byte) bool {
+	it, err := d.ValidationRecords(ctx, QueryValidationRecordsParams{Filter: func(r *ValidationRecord) bool {
+		return r.TxID == txID && bytes.Equal(r.TokenRequest, tokenRequest)
+	}})
+	if err != nil {
+		return false
+	}
+	defer it.Close()
+	r, err := it.Next()
+
+	return err == nil && r != nil
+}
