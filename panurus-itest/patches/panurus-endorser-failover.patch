+		selected, err := e.EndorserSelector.SelectEndorsers(context.Context(), e.TmsID, rest)
+		if err != nil {
+			failures = append(failures, err)
+
+			continue
+		}
+		logger.Warnf("endorsement failed, retrying without configured endorser [%d]", i)
+		env, err := e.requestApproval(context, requestRaw, txID, metadata, selected)
+		if err == nil {
+			return env, nil
+		}
+		failures = append(failures, err)
+	}
+
+	return nil, errors.Join(failures...)
+}
