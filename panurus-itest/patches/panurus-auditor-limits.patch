+
+// The three limits above are demonstration rules of the Panurus test auditor (200 per payment, 2000
+// cumulative over the last 10 payments, 3000 held). They are not BI's policy, so they can be set with
+// RDBI_PAYMENT_LIMIT, RDBI_CUMULATIVE_LIMIT and RDBI_HOLDING_LIMIT (decimal, per enrollment id and token
+// type); unset keeps the upstream value.
+func envLimit(name string, def int64) *big.Int {
+	if v := os.Getenv(name); v != "" {
+		if n, ok := new(big.Int).SetString(v, 10); ok {
+			return n
+		}
+	}
+	return big.NewInt(def)
+}
+
+func paymentLimit() *big.Int    { return envLimit("RDBI_PAYMENT_LIMIT", 200) }
+func cumulativeLimit() *big.Int { return envLimit("RDBI_CUMULATIVE_LIMIT", 2000) }
+func holdingLimit() *big.Int    { return envLimit("RDBI_HOLDING_LIMIT", 3000) }
